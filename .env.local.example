# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# In production these live only in Vercel's encrypted env vars (TRD §10).

# --- Database (Neon) ---
# Pooled connection string from the Neon–Vercel integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth (Better Auth) — used in Phase 3, listed here for completeness ---
# Session signing secret. Generate one, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (http://localhost:3000 in dev).
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth app credentials (identity + read-only Gmail, one consent screen).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The single allow-listed sign-in address (single-user guard, TRD §8).
ALLOWED_EMAIL=""

# --- AI (Phase 3) ---
OPENAI_API_KEY=""

# --- Cron (Phase 3) ---
# Shared bearer secret the Gmail-sync / reminder routes require.
CRON_SECRET=""
