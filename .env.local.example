# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
# In production these live only in Vercel's encrypted env vars (TRD §10).

# --- Database (Neon) ---
# Pooled connection string from the Neon–Vercel integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth (Better Auth) — used in Phase 3, listed here for completeness ---
# Session signing secret. Generate one, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (http://localhost:3000 in dev).
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth app credentials (identity + read-only Gmail, one consent screen).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The single allow-listed sign-in address (single-user guard, TRD §8).
ALLOWED_EMAIL=""

# --- AI ---
# The AI API key is entered in the app (Settings → AI provider) and stored
# encrypted in the DB — not here. This key encrypts it at rest: 32 bytes base64.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# --- Cron (Phase 3) ---
# Shared bearer secret the Gmail-sync / reminder routes require.
CRON_SECRET=""

# --- SMTP (password-reset emails) ---
# Optional fallback: the app prefers the DB smtp_config row (managed later from
# the admin dashboard) and uses these env vars only when that row is absent.
# If neither is set, the reset link is logged to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # "true" for port 465 (implicit TLS)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""          # e.g. "no-reply@yourdomain.com"
SMTP_FROM_NAME="Job Management Portal"
