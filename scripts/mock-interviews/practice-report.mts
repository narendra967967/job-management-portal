// R1.6: turns the practice runs (docs/interview-prep/r1.6/<model>.json, written
// by practice-runs.mts) into tables and readable transcripts.
//
//   node --import tsx scripts/mock-interviews/practice-report.mts gpt-6-luna gpt-6.1-terra gpt-4.1-mini
//
// Writes docs/interview-prep/r1.6/tables.md and transcripts-<model>.md.

import { existsSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

interface Run {
  run: number;
  model: string;
  scenario: { minutes: number; difficulty: string; category: string; role: string; persona: string; note?: string };
  status: string;
  planned: number;
  questionsAsked: number;
  followUps: number;
  answers: number;
  clockSeconds: number;
  tokensIn: number;
  tokensOut: number;
  costPaise: number;
  planMs: number;
  turnMsAvg: number;
  turnMsMax: number;
  reportWaitMs: number;
  report: { overall: number; scores: Record<string, number>; writing: { strengths: { headline: string; detail: string }[]; improvements: { headline: string; detail: string }[]; missed: { question: string; headline: string; note: string }[]; betterAnswers: { question: string; answer: string }[]; nextSteps: { headline: string; detail: string }[] } } | null;
  transcript: { from: string; kind: string; q: number | null; at: number; text: string }[];
  errors: { kind: string; detail: string }[];
  error?: string;
}

const dir = path.join("docs", "interview-prep", "r1.6");
const models = process.argv.slice(2);
const rupees = (p: number) => `₹${(p / 100).toFixed(2)}`;
const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : NaN);
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;

const out: string[] = ["# R1.6 practice runs: tables", "", "Generated by scripts/mock-interviews/practice-report.mts. AI cost is the interviewer's only (the simulated candidate is excluded).", ""];

for (const model of models) {
  const file = path.join(dir, `${model}.json`);
  if (!existsSync(file)) continue;
  const runs: Run[] = JSON.parse(readFileSync(file, "utf8")).filter((r: Run) => !r.error);
  out.push(`## ${model}`, "");
  out.push("| Run | Length | Level | Kind | Candidate | Overall | Questions + follow-ups | Clock | AI cost | Reply time (avg / max) |");
  out.push("|---|---|---|---|---|---|---|---|---|---|");
  for (const r of runs.sort((a, b) => a.run - b.run)) {
    out.push(
      `| ${r.run} | ${r.scenario.minutes} min | ${r.scenario.difficulty} | ${r.scenario.category} | ${r.scenario.persona} | ${r.report?.overall ?? "none"} | ${r.questionsAsked}/${r.planned} + ${r.followUps} | ${mmss(r.clockSeconds)} | ${rupees(r.costPaise)} | ${(r.turnMsAvg / 1000).toFixed(1)} s / ${(r.turnMsMax / 1000).toFixed(1)} s |`,
    );
  }
  out.push("", "**Cost by length**", "", "| Length | Runs | Average | Worst | Per minute (average) |", "|---|---|---|---|---|");
  for (const m of [15, 30, 45, 60]) {
    const xs = runs.filter((r) => r.scenario.minutes === m).map((r) => r.costPaise);
    if (!xs.length) continue;
    out.push(`| ${m} min | ${xs.length} | ${rupees(mean(xs))} | ${rupees(Math.max(...xs))} | ${rupees(mean(xs) / m)} |`);
  }
  out.push("", "**Scores by candidate strength**", "", "| Candidate | Runs | Average overall | Range |", "|---|---|---|---|");
  for (const p of ["strong", "average", "weak"]) {
    const xs = runs.filter((r) => r.scenario.persona === p && r.report).map((r) => r.report!.overall);
    if (xs.length) out.push(`| ${p} | ${xs.length} | ${Math.round(mean(xs))} | ${Math.min(...xs)} to ${Math.max(...xs)} |`);
  }
  const repeat = runs.filter((r) => [6, 16, 17].includes(r.run) && r.report).map((r) => r.report!.overall);
  if (repeat.length > 1) out.push("", `**Consistency:** the same setup (30 min Medium Project management, average candidate) run ${repeat.length} times scored ${repeat.join(", ")}.`);
  const errs = runs.flatMap((r) => r.errors.map((e) => `run ${r.run}: ${e.detail}`));
  out.push("", `**Errors and retries:** ${errs.length ? errs.join("; ") : "none"}.`);
  out.push(`**Plan writing time:** average ${(mean(runs.map((r) => r.planMs)) / 1000).toFixed(1)} s. **Report ready after ending:** average ${(mean(runs.map((r) => r.reportWaitMs)) / 1000).toFixed(1)} s.`, "");

  // Readable transcripts for the owner.
  const t: string[] = [`# ${model}: practice interviews`, "", "The candidate is a second AI playing a set strength. Interviewer lines are what candidates will see.", ""];
  for (const r of runs) {
    t.push(`## Run ${r.run}: ${r.scenario.minutes} min ${r.scenario.difficulty} ${r.scenario.category}, ${r.scenario.role} (${r.scenario.persona} candidate)`, "");
    if (r.report) {
      const s = r.report.scores;
      t.push(`**Overall ${r.report.overall}/100.** Communication ${s.communication}, technical ${s.technical}, confidence ${s.confidence}, problem-solving ${s.problemSolving}, relevance ${s.relevance}. AI cost ${rupees(r.costPaise)}.`, "");
      t.push("**What went well:** " + r.report.writing.strengths.map((p) => p.headline).join("; "), "");
      t.push("**To improve:** " + r.report.writing.improvements.map((p) => p.headline).join("; "), "");
      if (r.report.writing.missed.length) t.push("**Answers to work on:** " + r.report.writing.missed.map((m) => `${m.headline} (${m.question})`).join("; "), "");
    }
    t.push("<details><summary>Transcript</summary>", "");
    for (const m of r.transcript) t.push(`**${m.from === "ai" ? (m.kind === "follow_up" ? "Interviewer (follow-up)" : m.q ? `Interviewer (Q${m.q})` : "Interviewer") : "Candidate"}** [${mmss(m.at)}]: ${m.text}`, "");
    t.push("</details>", "");
  }
  writeFileSync(path.join(dir, `transcripts-${model}.md`), t.join("\n"));
}
writeFileSync(path.join(dir, "tables.md"), out.join("\n"));
console.log(`Wrote ${path.join(dir, "tables.md")} and transcripts.`);
