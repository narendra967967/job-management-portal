+/**
+ * The five skill scores, built from the per-answer ratings: each skill is the
+ * average of its rating across the answers, so a run of vague answers pulls it
+ * down instead of being smoothed over. Falls back to the AI's overall view
+ * when the reply has no ratings.
+ */
+export function skillScores(r: EvaluationReply): MetricScores {
+  const answers = r.answers ?? [];
+  if (!answers.length) return r.scores;
+  const avg = (k: keyof MetricScores) => {
+    const v = answers.reduce((n, a) => n + a.ratings[k], 0) / answers.length;
+    return Math.min(10, Math.max(1, Math.round(v)));
+  };
+  return { communication: avg("communication"), technical: avg("technical"), confidence: avg("confidence"), problemSolving: avg("problemSolving"), relevance: avg("relevance") };
+}
