# → /srv/jobtiva/env/prod.env  and  /srv/jobtiva/env/preprod.env   (chmod 600)
#
# One KEY=value per line, NO quotes, no spaces around "=". (Values are read
# literally; cron-run.sh also greps CRON_SECRET out of this file.)
#
# PROD gets FRESH secrets.  PREPROD (migrated from AWS) must REUSE its existing
# APP_ENCRYPTION_KEY and BETTER_AUTH_SECRET — stored AI keys / Gmail tokens are
# encrypted with that key and become unreadable under a new one.

# Label shown on the admin dashboard.
APP_ENV=Production

# Postgres service on the compose network (host "postgres", no SSL needed inside it).
#   prod:    postgresql://jmp_prod:<PROD_DB_PASSWORD>@postgres:5432/jmp_prod
#   preprod: postgresql://jmp_preprod:<PREPROD_DB_PASSWORD>@postgres:5432/jmp_preprod
DATABASE_URL=

#   prod: https://jobtiva.in      preprod: https://preprod.jobtiva.in
BETTER_AUTH_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32   (preprod: copy the existing one!)
APP_ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=

# Google OAuth (read-only Gmail linking). Same client for both envs; register
# each env's origin + /api/auth/callback/google redirect URI on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email forwarding. INBOUND_DOMAIN is this env's receiving domain:
#   prod: in.jobtiva.in      preprod: in.preprod.jobtiva.in
# INBOUND_SECRET must equal the one in env/mail-in.env (openssl rand -hex 32).
INBOUND_DOMAIN=
INBOUND_SECRET=

# Uploads on disk, inside the per-env Docker volume.
STORAGE_DRIVER=local
UPLOADS_DIR=/data/uploads

# SMTP — optional here: the admin Settings → Email (SMTP) values take precedence.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Jobtiva
