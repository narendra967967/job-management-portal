# → /srv/jobtiva/.env   (chmod 600 — never commit the real file)
# Compose-level variables. Generate each password with:  openssl rand -hex 24
# (letters/digits only — postgres-init.sh embeds them in SQL).

POSTGRES_PASSWORD=
PROD_DB_PASSWORD=
PREPROD_DB_PASSWORD=

# Which image each app runs. deploy.sh rewrites these on every deploy — don't edit
# by hand except to roll back (or just run: deploy.sh <env> <older-sha>).
PROD_IMAGE=jobtiva:none
PREPROD_IMAGE=jobtiva:none
