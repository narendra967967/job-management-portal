# Production environment template (AWS). Copy the values into the server's
# runtime env — on EC2 this is an `.env` file passed to `docker run --env-file`
# (chmod 600, NEVER committed), and in CI they come from AWS SSM Parameter Store
# per environment (/jmp/preprod/*, /jmp/prod/*).
#
# Two environments share one RDS instance with two databases:
#   preprod -> jmp_preprod   prod -> jmp_prod

# --- Database (Amazon RDS PostgreSQL) ---
# RDS requires TLS. Use the env's own database name.
#   preprod: .../jmp_preprod   prod: .../jmp_prod
DATABASE_URL="postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/jmp_prod?sslmode=require"

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=""                       # openssl rand -base64 32 (unique per env)
BETTER_AUTH_URL="https://jmp.narendragupta.in"   # preprod: https://preprod.jmp.narendragupta.in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Add each env's callback to the Google OAuth client's Authorized redirect URIs:
#   https://jmp.narendragupta.in/api/auth/callback/google
#   https://preprod.jmp.narendragupta.in/api/auth/callback/google
ALLOWED_EMAIL=""                            # the single allow-listed sign-in address

# --- Secrets at rest ---
APP_ENCRYPTION_KEY=""                        # 32 bytes base64 (unique per env)

# --- Cron (EventBridge Scheduler -> POST /api/cron/gmail-sync) ---
CRON_SECRET=""                               # unique per env; set the same value on the schedule

# --- Résumé file storage (Amazon S3) ---
# One bucket per env, e.g. jmp-preprod-resumes / jmp-prod-resumes (Mumbai).
# On EC2, prefer the instance IAM role over static keys (leave keys blank then).
S3_BUCKET=""
S3_REGION="ap-south-1"
# Only if NOT using an instance role:
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- SMTP (password-reset emails) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"                          # "true" for port 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Job Management Portal"
